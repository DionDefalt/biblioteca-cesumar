# ---- Etapa 1: build do WAR com Maven ----
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# ---- Etapa 2: imagem final, só com Tomcat + o WAR pronto ----
FROM tomcat:10.1-jdk17-temurin
RUN rm -rf /usr/local/tomcat/webapps/ROOT
COPY --from=build /app/target/biblioteca-diondefalt.war /usr/local/tomcat/webapps/biblioteca-diondefalt.war
EXPOSE 8080
CMD ["catalina.sh", "run"]